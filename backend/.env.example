# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=explicite
POSTGRES_PASSWORD=change_this_in_production
POSTGRES_DB=explicite_ai

# Async DSN consumed by SQLAlchemy and Alembic
DATABASE_URL=postgresql+asyncpg://explicite:change_this_in_production@localhost:5432/explicite_ai

# Test database (separate DB, same host)
TEST_DATABASE_URL=postgresql+asyncpg://explicite:change_this_in_production@localhost:5432/test_explicite_ai

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: py -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=replace_with_64_byte_hex_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8443

# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0

# ── Upload / analysis ─────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
ANALYSIS_TIMEOUT_SECONDS=300

# ── LLM provider ──────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to "anthropic" or "ollama" to enable AI features.
# Leave as "none" (the default) to run without AI; all AI endpoints return 503.
LLM_PROVIDER=none
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=512
